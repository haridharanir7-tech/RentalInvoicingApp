# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Central PostgreSQL)
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rental_invoicing_db

# Or individual parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rental_invoicing_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
